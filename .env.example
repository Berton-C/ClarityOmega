# ClarityOmega environment configuration
#
# Copy this file to .env in the repository root and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. This file is the
# template and must never contain real credentials.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# ClarityOmega reaches its language model through a LiteLLM proxy. Set the key
# for whichever provider you route to. At least one must be present.

# Anthropic (Claude) API key.
ANTHROPIC_API_KEY=

# Friendli API key. The reference deployment uses Friendli serverless
# (base URL https://api.friendli.ai/serverless/v1).
FRIENDLI_API_KEY=

# OpenAI API key. Commented out in docker-compose.yml by default. Uncomment
# there as well if you route to OpenAI, or if you use the upstream memory
# system's embedding model (text-embedding-3-large).
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Mattermost (Clarity's communication channel)
# ---------------------------------------------------------------------------
# Both values come from your Mattermost server after you create a bot account
# and add it to a channel. See docs/SETUP.md for how to obtain them.

# The bot account's personal access token.
MM_BOT_TOKEN=

# The ID of the channel Clarity should join. This is the long alphanumeric
# channel ID, not the human-readable channel name.
MM_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Password for the bundled PostgreSQL instance backing Mattermost.
#
# SECURITY: docker-compose.yml falls back to the default value
# "mmuser_password" when this is unset. That default is acceptable only for a
# strictly local deployment with no exposed ports. Set a real password here
# before running anywhere reachable from another machine.
POSTGRES_PASSWORD=
